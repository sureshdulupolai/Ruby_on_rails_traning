<div class="max-w-2xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
  <!-- Profile Header -->
  <div class="mb-8">
    <h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Account Settings</h1>
    <p class="mt-1 text-sm text-slate-500">Manage your profile credentials and security preferences.</p>
  </div>

  <!-- Security & Password Card -->
  <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 p-6 sm:p-8 mb-8">
    <h2 class="text-lg font-semibold text-slate-900 mb-6 flex items-center gap-2">
      <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
      </svg>
      Security & Email
    </h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-6" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <!-- Email -->
      <div>
        <%= f.label :email, class: "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
            class: "block w-full px-3.5 py-2.5 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent focus:bg-white transition duration-200" %>
        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <p class="mt-1.5 text-xs text-amber-600 font-medium">Currently waiting confirmation for: <%= resource.unconfirmed_email %></p>
        <% end %>
      </div>

      <!-- New Password -->
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <%= f.label :password, "New Password", class: "block text-xs font-semibold uppercase tracking-wider text-slate-700" %>
          <span class="text-xs text-slate-400 font-normal">Leave blank if you don't want to change it</span>
        </div>
        <%= f.password_field :password, autocomplete: "new-password", placeholder: "••••••••",
            class: "block w-full px-3.5 py-2.5 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent focus:bg-white transition duration-200" %>
        <% if @minimum_password_length %>
          <p class="mt-1.5 text-[11px] text-slate-400"><%= @minimum_password_length %> characters minimum</p>
        <% end %>
      </div>

      <!-- Password Confirmation -->
      <div>
        <%= f.label :password_confirmation, "Confirm New Password", class: "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "••••••••",
            class: "block w-full px-3.5 py-2.5 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent focus:bg-white transition duration-200" %>
      </div>

      <!-- Current Password -->
      <div class="pt-4 border-t border-slate-100">
        <div class="flex items-center justify-between mb-1.5">
          <%= f.label :current_password, "Current Password", class: "block text-xs font-semibold uppercase tracking-wider text-slate-700" %>
          <span class="text-xs text-indigo-600 font-medium">Required to confirm changes</span>
        </div>
        <%= f.password_field :current_password, autocomplete: "current-password", required: true, placeholder: "••••••••",
            class: "block w-full px-3.5 py-2.5 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent focus:bg-white transition duration-200" %>
      </div>

      <!-- Submit Action -->
      <div class="flex items-center justify-end gap-3 pt-4">
        <%= link_to "Cancel", :back, class: "px-4 py-2 rounded-xl text-sm font-medium text-slate-700 hover:bg-slate-100 transition-colors" %>
        <%= f.submit "Save Changes", class: "px-5 py-2.5 rounded-xl shadow-md text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-all cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <!-- Danger Zone -->
  <div class="bg-red-50/50 rounded-2xl border border-red-200 p-6 sm:p-8">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h3 class="text-base font-semibold text-red-900">Delete Account</h3>
        <p class="text-xs text-red-600 mt-1">Once you delete your account, all your expenses and recorded data will be permanently removed.</p>
      </div>
      <div>
        <%= button_to "Cancel My Account", registration_path(resource_name),
            data: { confirm: "Are you sure? All your data will be permanently lost.", turbo_confirm: "Are you sure? All your data will be permanently lost." },
            method: :delete,
            class: "inline-flex items-center justify-center px-4 py-2.5 border border-red-300 rounded-xl text-sm font-medium text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 shadow-sm transition-all cursor-pointer" %>
      </div>
    </div>
  </div>
</div>
