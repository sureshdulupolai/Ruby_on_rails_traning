<div class="space-y-8">
  <!-- Welcome & Action Banner -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-white p-6 sm:p-8 rounded-2xl border border-slate-200/80 shadow-xs">
    <div>
      <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-indigo-600 mb-1">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Personal Dashboard
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">
        Welcome, <%= current_user.display_name %> 👋
      </h1>
      <p class="mt-1 text-sm text-slate-500">Here is an overview of your recent expenses and spending breakdown.</p>
    </div>

    <div>
      <%= link_to new_expense_path, class: "inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl font-semibold text-sm text-white bg-indigo-600 hover:bg-indigo-700 shadow-md shadow-indigo-100 transition-all hover:shadow hover:-translate-y-0.5" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
        </svg>
        Record New Expense
      <% end %>
    </div>
  </div>

  <!-- Summary Metric Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
    <!-- Total Expenses -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs flex items-center gap-4">
      <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center flex-shrink-0">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Total Spent</p>
        <h3 class="text-2xl font-bold text-slate-900 mt-0.5">
          ₹<%= number_with_precision(@expenses.sum(&:amount), precision: 2) %>
        </h3>
      </div>
    </div>

    <!-- Total Transactions -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs flex items-center gap-4">
      <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center flex-shrink-0">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
        </svg>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Total Records</p>
        <h3 class="text-2xl font-bold text-slate-900 mt-0.5">
          <%= @expenses.count %>
        </h3>
      </div>
    </div>

    <!-- Active User -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs flex items-center gap-4">
      <div class="w-12 h-12 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center flex-shrink-0">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
      </div>
      <div class="min-w-0">
        <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Signed In As</p>
        <h3 class="text-sm font-bold text-slate-900 truncate mt-0.5">
          <%= current_user.email %>
        </h3>
      </div>
    </div>
  </div>

  <!-- Expenses Table -->
  <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs overflow-hidden">
    <div class="px-6 py-5 border-b border-slate-100 flex items-center justify-between">
      <h2 class="text-lg font-bold text-slate-900">Recent Transactions</h2>
      <span class="text-xs font-medium text-slate-400">Showing all records for your account</span>
    </div>

    <% if @expenses.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-50/75 border-b border-slate-100 text-xs font-semibold uppercase tracking-wider text-slate-500">
              <th class="py-3.5 px-6">Date</th>
              <th class="py-3.5 px-6">Category</th>
              <th class="py-3.5 px-6">Description</th>
              <th class="py-3.5 px-6">Amount</th>
              <th class="py-3.5 px-6 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-sm">
            <% @expenses.each do |expense| %>
              <tr class="hover:bg-slate-50/50 transition-colors">
                <td class="py-4 px-6 text-slate-600 whitespace-nowrap font-medium">
                  <%= expense.date.strftime("%b %d, %Y") %>
                </td>
                <td class="py-4 px-6 whitespace-nowrap">
                  <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold bg-indigo-50 text-indigo-700">
                    <%= expense.category %>
                  </span>
                </td>
                <td class="py-4 px-6 text-slate-600 max-w-xs truncate">
                  <%= expense.description.presence || "—" %>
                </td>
                <td class="py-4 px-6 font-bold text-slate-900 whitespace-nowrap">
                  ₹<%= number_with_precision(expense.amount, precision: 2) %>
                </td>
                <td class="py-4 px-6 text-right whitespace-nowrap">
                  <div class="flex items-center justify-end gap-2">
                    <%= link_to "View", expense_path(expense), class: "px-2.5 py-1 text-xs font-semibold text-slate-600 hover:text-indigo-600 hover:bg-slate-100 rounded-lg transition-colors" %>
                    <%= link_to "Edit", edit_expense_path(expense), class: "px-2.5 py-1 text-xs font-semibold text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors" %>
                    <%= button_to "Delete", expense_path(expense), method: :delete, data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this expense?" }, class: "px-2.5 py-1 text-xs font-semibold text-red-600 hover:bg-red-50 rounded-lg transition-colors cursor-pointer" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-16 px-4">
        <div class="w-16 h-16 rounded-2xl bg-slate-100 text-slate-400 flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="text-base font-semibold text-slate-900">No expenses recorded yet</h3>
        <p class="text-sm text-slate-500 mt-1 max-w-sm mx-auto">Get started by creating your first expense entry to keep track of your spending habits.</p>
        <div class="mt-6">
          <%= link_to new_expense_path, class: "inline-flex items-center px-4 py-2 rounded-xl text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm" do %>
            <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Add Your First Expense
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
