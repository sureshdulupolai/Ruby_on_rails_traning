<%= form_with(model: expense, local: true, class: "space-y-6") do |form| %>
  <% if expense.errors.any? %>
    <div class="p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 shadow-sm" role="alert">
      <div class="flex items-start gap-3">
        <svg class="h-5 w-5 text-red-500 flex-shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
        </svg>
        <div>
          <h4 class="text-sm font-semibold text-red-900"><%= pluralize(expense.errors.count, "error") %> prohibited this expense from being saved:</h4>
          <ul class="mt-2 text-xs font-medium text-red-700 list-disc list-inside space-y-1">
            <% expense.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <!-- Date Field -->
    <div>
      <%= form.label :date, class: "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5" %>
      <%= form.date_field :date, required: true,
          class: "block w-full px-3.5 py-2.5 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent focus:bg-white transition duration-200" %>
    </div>

    <!-- Amount Field -->
    <div>
      <%= form.label :amount, "Amount (₹)", class: "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5" %>
      <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 font-bold">₹</div>
        <%= form.number_field :amount, step: 0.01, placeholder: "0.00", required: true,
            class: "block w-full pl-8 pr-3.5 py-2.5 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-900 placeholder-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent focus:bg-white transition duration-200" %>
      </div>
    </div>
  </div>

  <!-- Category Field -->
  <div>
    <%= form.label :category, class: "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5" %>
    <%= form.select :category, Expense::VALID_CATEGORIES, { prompt: "Select a category" }, { required: true, class: "block w-full px-3.5 py-2.5 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent focus:bg-white transition duration-200" } %>
  </div>

  <!-- Description Field -->
  <div>
    <%= form.label :description, "Description (Optional)", class: "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5" %>
    <%= form.text_area :description, rows: 3, placeholder: "Add notes or details about this expense...",
        class: "block w-full px-3.5 py-2.5 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-900 placeholder-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent focus:bg-white transition duration-200" %>
  </div>

  <!-- Buttons -->
  <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
    <%= link_to "Cancel", expenses_path, class: "px-4 py-2 rounded-xl text-sm font-medium text-slate-700 hover:bg-slate-100 transition-colors" %>
    <%= form.submit class: "px-6 py-2.5 rounded-xl font-semibold text-sm text-white bg-indigo-600 hover:bg-indigo-700 shadow-md shadow-indigo-100 transition-all cursor-pointer" %>
  </div>
<% end %>
