<div class="max-w-2xl mx-auto py-8">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Edit Expense</h1>
      <p class="mt-1 text-sm text-slate-500">Update the details for this transaction.</p>
    </div>
    <%= link_to "← Back to Expenses", expenses_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-500 hover:underline" %>
  </div>

  <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 p-6 sm:p-8">
    <%= render "form", expense: @expense %>
  </div>
</div>
