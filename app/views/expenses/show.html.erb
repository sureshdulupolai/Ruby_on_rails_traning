<div class="container mt-5">
  <div class="row">
    <div class="col-md-8 offset-md-2">
      <div class="card">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
              <h1 class="card-title mb-0">
                <span class="badge bg-info text-dark"><%= @expense.category %></span>
              </h1>
              <p class="text-muted mt-2 mb-0">
                <span class="fs-4 fw-bold">₹<%= number_with_precision(@expense.amount, precision: 2) %></span>
              </p>
            </div>
          </div>

          <div class="expense-details">
            <div class="row mb-4">
              <div class="col-md-6">
                <h6 class="text-muted">Date</h6>
                <p class="fs-5"><%= @expense.date.strftime("%d %B %Y") %></p>
              </div>
              <div class="col-md-6">
                <h6 class="text-muted">Category</h6>
                <p class="fs-5"><%= @expense.category %></p>
              </div>
            </div>

            <div class="row mb-4">
              <div class="col">
                <h6 class="text-muted">Amount</h6>
                <p class="fs-5 fw-bold">₹<%= number_with_precision(@expense.amount, precision: 2) %></p>
              </div>
            </div>

            <% if @expense.description.present? %>
              <div class="row mb-4">
                <div class="col">
                  <h6 class="text-muted">Description</h6>
                  <p class="fs-5">
                    <%= simple_format(@expense.description) %>
                  </p>
                </div>
              </div>
            <% end %>
          </div>

          <div class="d-flex gap-2 mt-5">
            <%= link_to "Edit", edit_expense_path(@expense), class: "btn btn-warning" %>
            <%= link_to "Delete", expense_path(@expense), method: :delete, data: {turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this expense?" }, class: "btn btn-danger" %>
            <%= link_to "Back to Expenses", expenses_path, class: "btn btn-secondary" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
