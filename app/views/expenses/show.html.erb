<div class="max-w-2xl mx-auto py-8">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Expense Details</h1>
      <p class="mt-1 text-sm text-slate-500">Transaction summary and metadata.</p>
    </div>
    <%= link_to "← Back to Expenses", expenses_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-500 hover:underline" %>
  </div>

  <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 overflow-hidden">
    <!-- Header Banner -->
    <div class="p-6 sm:p-8 bg-gradient-to-r from-indigo-50 to-violet-50 border-b border-slate-200/60 flex items-center justify-between">
      <div>
        <span class="text-xs font-semibold uppercase tracking-wider text-indigo-600">Amount</span>
        <h2 class="text-3xl font-extrabold text-slate-900 mt-1">₹<%= number_with_precision(@expense.amount, precision: 2) %></h2>
      </div>
      <div>
        <span class="inline-flex items-center px-3 py-1.5 rounded-xl text-sm font-semibold bg-indigo-600 text-white shadow-xs">
          <%= @expense.category %>
        </span>
      </div>
    </div>

    <!-- Details Grid -->
    <div class="p-6 sm:p-8 space-y-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pb-6 border-b border-slate-100">
        <div>
          <span class="block text-xs font-semibold uppercase tracking-wider text-slate-400">Date</span>
          <p class="text-sm font-medium text-slate-800 mt-1"><%= @expense.date.strftime("%B %d, %Y") %></p>
        </div>
        <div>
          <span class="block text-xs font-semibold uppercase tracking-wider text-slate-400">Recorded By</span>
          <p class="text-sm font-medium text-slate-800 mt-1"><%= current_user.email %></p>
        </div>
      </div>

      <div>
        <span class="block text-xs font-semibold uppercase tracking-wider text-slate-400">Description</span>
        <p class="text-sm text-slate-700 mt-1 leading-relaxed"><%= @expense.description.presence || "No description provided." %></p>
      </div>

      <!-- Actions -->
      <div class="flex items-center justify-end gap-3 pt-6 border-t border-slate-100">
        <%= link_to "Edit", edit_expense_path(@expense), class: "px-4 py-2 rounded-xl text-sm font-semibold text-indigo-600 bg-indigo-50 hover:bg-indigo-100 transition-colors" %>
        <%= button_to "Delete", expense_path(@expense), method: :delete, data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this expense?" }, class: "px-4 py-2 rounded-xl text-sm font-semibold text-red-600 bg-red-50 hover:bg-red-100 transition-colors cursor-pointer" %>
      </div>
    </div>
  </div>
</div>
