<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50 font-sans text-slate-900 antialiased">
  <head>
    <title><%= content_for(:title) || "Expense Tracker - Personal Finance & Budgeting" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Expense Tracker">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Tailwind CSS (via Tailwind CDN for instant zero-config styling) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              sans: ['Inter', 'sans-serif'],
            },
            colors: {
              brand: {
                50: '#eef2ff',
                100: '#e0e7ff',
                500: '#6366f1',
                600: '#4f46e5',
                700: '#4338ca',
              }
            }
          }
        }
      }
    </script>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-full flex flex-col bg-slate-50 text-slate-800 selection:bg-indigo-500 selection:text-white">
    <!-- Main Navigation Bar -->
    <nav class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-200/80 shadow-xs">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16 items-center">
          
          <!-- Logo & Brand -->
          <div class="flex items-center gap-3">
            <%= link_to root_path, class: "flex items-center gap-2.5 group transition-transform duration-200 hover:scale-[1.02]" do %>
              <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-violet-600 flex items-center justify-center text-white shadow-md shadow-indigo-100 group-hover:shadow-indigo-200 transition-shadow">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <span class="text-xl font-black tracking-tight text-slate-900">
                Expense<span class="text-indigo-600">Tracker</span>
              </span>
            <% end %>
          </div>

          <!-- Nav Links & Auth Controls -->
          <div class="flex items-center gap-3 sm:gap-4">
            <% if user_signed_in? %>
              <!-- Dashboard Link -->
              <%= link_to expenses_path, class: "hidden sm:inline-flex items-center px-3.5 py-2 text-sm font-medium text-slate-700 hover:text-indigo-600 rounded-lg hover:bg-slate-100 transition-colors" do %>
                <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                </svg>
                Dashboard
              <% end %>

              <!-- New Expense Quick Action -->
              <%= link_to new_expense_path, class: "inline-flex items-center px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm shadow-indigo-200 transition-all hover:shadow hover:-translate-y-0.5" do %>
                <svg class="w-4 h-4 mr-1 sm:mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                Add Expense
              <% end %>

              <!-- User Profile & Sign Out Dropdown/Group -->
              <div class="flex items-center gap-2 pl-2 border-l border-slate-200">
                <%= link_to edit_user_registration_path, class: "flex items-center gap-2 p-1.5 rounded-xl hover:bg-slate-100 transition-colors group", title: "Account Settings" do %>
                  <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-indigo-500 to-purple-500 text-white font-bold text-xs flex items-center justify-center shadow-xs">
                    <%= current_user.email.first(2).upcase %>
                  </div>
                  <span class="hidden md:inline-block text-xs font-semibold text-slate-700 group-hover:text-indigo-600 max-w-[140px] truncate">
                    <%= current_user.email %>
                  </span>
                <% end %>

                <!-- Sign Out Button -->
                <%= button_to destroy_user_session_path, method: :delete, data: { turbo_method: :delete },
                    class: "inline-flex items-center p-2 rounded-xl text-slate-400 hover:text-red-600 hover:bg-red-50 transition-colors cursor-pointer",
                    title: "Sign Out" do %>
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                  </svg>
                <% end %>
              </div>
            <% else %>
              <!-- Logged Out Actions -->
              <%= link_to "Sign In", new_user_session_path, class: "px-4 py-2 text-sm font-semibold text-slate-700 hover:text-indigo-600 rounded-xl hover:bg-slate-100 transition-colors" %>
              <%= link_to "Get Started", new_user_registration_path, class: "px-4 py-2 text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-xl shadow-sm shadow-indigo-200 transition-all hover:shadow hover:-translate-y-0.5" %>
            <% end %>
          </div>

        </div>
      </div>
    </nav>

    <!-- Flash Alerts Container -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4 w-full">
      <% if notice.present? %>
        <div class="flex items-center justify-between p-4 mb-4 text-sm text-emerald-800 rounded-2xl bg-emerald-50 border border-emerald-200/80 shadow-xs animate-fade-in" role="alert">
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="font-medium"><%= notice %></span>
          </div>
        </div>
      <% end %>

      <% if alert.present? %>
        <div class="flex items-center justify-between p-4 mb-4 text-sm text-rose-800 rounded-2xl bg-rose-50 border border-rose-200/80 shadow-xs animate-fade-in" role="alert">
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-rose-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <span class="font-medium"><%= alert %></span>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Page Body -->
    <main class="flex-1 max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-6">
      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="mt-auto border-t border-slate-200/70 bg-white py-6">
      <div class="max-w-7xl mx-auto px-4 text-center text-xs text-slate-400">
        &copy; <%= Time.current.year %> ExpenseTracker. All rights reserved. Secure authentication powered by Devise.
      </div>
    </footer>
  </body>
</html>
